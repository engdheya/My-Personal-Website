##############################################################
#  DheyaDev — Environment file (XAMPP / PHP 8.2 ready)
#  Copy this file to ".env" then run: php artisan key:generate
##############################################################

APP_NAME="DheyaDev"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Baghdad

# APP_URL must be a full URL WITHOUT a trailing slash:
#   - project inside htdocs, e.g. C:\xampp\htdocs\dheyadev  ->  http://localhost/dheyadev/public
#   - Apache document root pointed at the public/ folder    ->  http://localhost
#   - built-in server (php artisan serve)                   ->  http://127.0.0.1:8000
APP_URL=http://localhost/dheyadev/public

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

##############################################################
#  Database
##############################################################
# Option A — MySQL / MariaDB (recommended: pdo_mysql is enabled by default in XAMPP)
# 1) Start Apache + MySQL in the XAMPP control panel
# 2) php artisan xampp:create-database
# 3) php artisan migrate --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dheyadev
DB_USERNAME=root
DB_PASSWORD=

# Option B — SQLite (no server needed, ships with a ready-made seeded database)
# Requires enabling pdo_sqlite inside xampp/php/php.ini, then restarting Apache:
#   extension=pdo_sqlite
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local development: mails are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dheyadev.com"
MAIL_FROM_NAME="${APP_NAME}"

# For a real SMTP account (production / live notifications):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls

# Filament admin panel
FILAMENT_PATH=admin
FILAMENT_BRAND="DheyaDev CMS"
FILAMENT_FILESYSTEM_DISK=public

# Seeded administrator account (php artisan migrate --seed)
ADMIN_NAME="Dheya Abbas"
ADMIN_EMAIL="admin@dheyadev.com"
ADMIN_PASSWORD="password"
