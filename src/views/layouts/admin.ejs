<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - Filament CMS' : 'DheyaDev Admin CMS' %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/app.css">
  <script>
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col antialiased font-sans">
  
  <div class="flex h-screen overflow-hidden">
    
    <!-- Sidebar Navigation (Filament Style) -->
    <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between flex-shrink-0 z-30 hidden md:flex text-slate-300">
      
      <!-- Top Brand -->
      <div>
        <div class="h-16 flex items-center px-6 border-b border-slate-800 gap-3">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-base shadow">
            D
          </div>
          <div>
            <div class="text-sm font-bold text-white tracking-wide">DheyaDev CMS</div>
            <div class="text-[10px] text-blue-400 font-mono">Filament Admin v3</div>
          </div>
        </div>

        <!-- Nav Items -->
        <nav class="p-4 space-y-1 text-xs font-semibold">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'dashboard' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>📊</span>
            <span>Dashboard</span>
          </a>

          <div class="pt-3 pb-1 px-3 text-[10px] uppercase font-bold text-slate-500 tracking-wider">Content</div>

          <a href="/admin/posts" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'posts' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>📝</span>
            <span class="flex-1">Posts / Articles</span>
          </a>

          <a href="/admin/categories" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'categories' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>📁</span>
            <span>Categories</span>
          </a>

          <a href="/admin/tags" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'tags' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>🏷️</span>
            <span>Tags</span>
          </a>

          <div class="pt-3 pb-1 px-3 text-[10px] uppercase font-bold text-slate-500 tracking-wider">Showcase</div>

          <a href="/admin/projects" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'projects' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>🚀</span>
            <span>Projects</span>
          </a>

          <a href="/admin/services" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'services' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>⚡</span>
            <span>Services</span>
          </a>

          <div class="pt-3 pb-1 px-3 text-[10px] uppercase font-bold text-slate-500 tracking-wider">System</div>

          <a href="/admin/messages" class="flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'messages' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <div class="flex items-center gap-3">
              <span>✉️</span>
              <span>Messages</span>
            </div>
            <% if (typeof unreadMessagesCount !== 'undefined' && unreadMessagesCount > 0) { %>
              <span class="px-2 py-0.5 rounded-full bg-rose-500 text-white text-[10px] font-bold"><%= unreadMessagesCount %></span>
            <% } %>
          </a>

          <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-800 transition-colors <%= activeAdminNav === 'settings' ? 'bg-blue-600 text-white font-bold' : 'text-slate-300' %>">
            <span>⚙️</span>
            <span>Site & SEO Settings</span>
          </a>
        </nav>
      </div>

      <!-- Bottom Profile & Logout -->
      <div class="p-4 border-t border-slate-800 space-y-3">
        <a href="/" target="_blank" class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
          <span>🌐</span>
          <span>View Public Site ↗</span>
        </a>
        
        <div class="flex items-center justify-between pt-2">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold text-xs">
              DA
            </div>
            <div class="text-xs">
              <div class="font-bold text-white">Dheya Abbas</div>
              <div class="text-[10px] text-slate-400">admin@dheyadev.com</div>
            </div>
          </div>
          <a href="/admin/logout" title="Logout" class="p-2 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          </a>
        </div>
      </div>

    </aside>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      
      <!-- Top Bar -->
      <header class="h-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-4 sm:px-8 flex-shrink-0 z-20">
        <div class="flex items-center gap-4">
          <!-- Mobile Menu Toggle Button -->
          <button id="admin-mobile-btn" class="md:hidden p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <div class="font-bold text-slate-900 dark:text-white text-base">
            <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Theme Toggle -->
          <button type="button" id="admin-theme-toggle" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>

          <!-- Public site link -->
          <a href="/" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:border-blue-500 hover:text-blue-600 transition-colors">
            <span>Public Site</span>
            <span>↗</span>
          </a>
        </div>
      </header>

      <!-- Scrollable Main Container -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-8 bg-slate-50 dark:bg-slate-950">
        
        <!-- Alerts -->
        <% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %>
          <div class="mb-6 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs font-medium flex items-center justify-between shadow-sm">
            <span><%= flashSuccess %></span>
            <button onclick="this.parentElement.remove()" class="text-emerald-600">✕</button>
          </div>
        <% } %>

        <% if (typeof flashError !== 'undefined' && flashError) { %>
          <div class="mb-6 p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 text-xs font-medium flex items-center justify-between shadow-sm">
            <span><%= flashError %></span>
            <button onclick="this.parentElement.remove()" class="text-rose-600">✕</button>
          </div>
        <% } %>

        <%- body %>
      </main>

    </div>

  </div>

  <script>
    const themeBtn = document.getElementById('admin-theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.theme = 'light';
        } else {
          document.documentElement.classList.add('dark');
          localStorage.theme = 'dark';
        }
      });
    }

    const mobileBtn = document.getElementById('admin-mobile-btn');
    const sidebar = document.querySelector('aside');
    if (mobileBtn && sidebar) {
      mobileBtn.addEventListener('click', () => {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('fixed');
        sidebar.classList.toggle('inset-y-0');
        sidebar.classList.toggle('left-0');
      });
    }
  </script>
</body>
</html>
