<% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0) { %>
<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-medium">
    <li>
      <a href="/<%= currentLang === 'en' ? '?lang=en' : '' %>" class="hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span><%= t.nav_home %></span>
      </a>
    </li>
    <% breadcrumbs.forEach((b, index) => { %>
      <li class="flex items-center gap-1.5">
        <span class="text-slate-400 dark:text-slate-600">/</span>
        <% if (index === breadcrumbs.length - 1) { %>
          <span class="text-slate-900 dark:text-slate-200 font-semibold truncate max-w-xs sm:max-w-md" aria-current="page"><%= b.name %></span>
        <% } else { %>
          <a href="<%= b.url %><%= currentLang === 'en' ? '?lang=en' : '' %>" class="hover:text-blue-600 dark:hover:text-blue-400"><%= b.name %></a>
        <% } %>
      </li>
    <% }) %>
  </ol>
</nav>
<% } %>
