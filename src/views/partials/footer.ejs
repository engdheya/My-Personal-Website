<footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/80 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Bio Column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-extrabold text-lg shadow-sm">
            D
          </div>
          <div>
            <span class="font-bold text-lg text-slate-900 dark:text-white tracking-tight">
              <%= settings.site_name || 'DheyaDev' %>
            </span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">
              <%= currentLang === 'ar' ? (settings.author_title_ar || 'مهندس ومطور برمجيات') : (settings.author_title || 'Software Engineer & Developer') %>
            </span>
          </div>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          <%= currentLang === 'ar' ? (settings.site_description_ar || t.footer_bio) : (settings.site_description || t.footer_bio) %>
        </p>
        <div class="pt-2 text-xs text-slate-500 font-mono">
          <span>Domain: <a href="https://dheyadev.com" class="text-blue-600 dark:text-blue-400 hover:underline">dheyadev.com</a></span>
          <span class="mx-2">•</span>
          <span>Status: <span class="text-emerald-500">● Operational</span></span>
        </div>
      </div>

      <!-- Quick Navigation Column -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-4">
          <%= t.footer_quick_links %>
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/<%= currentLang === 'en' ? '?lang=en' : '' %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <%= t.nav_home %>
            </a>
          </li>
          <li>
            <a href="/about<%= currentLang === 'en' ? '?lang=en' : '' %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <%= t.nav_about %>
            </a>
          </li>
          <li>
            <a href="/projects<%= currentLang === 'en' ? '?lang=en' : '' %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <%= t.nav_projects %>
            </a>
          </li>
          <li>
            <a href="/blog<%= currentLang === 'en' ? '?lang=en' : '' %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <%= t.nav_blog %>
            </a>
          </li>
          <li>
            <a href="/services<%= currentLang === 'en' ? '?lang=en' : '' %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <%= t.nav_services %>
            </a>
          </li>
          <li>
            <a href="/contact<%= currentLang === 'en' ? '?lang=en' : '' %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <%= t.nav_contact %>
            </a>
          </li>
        </ul>
      </div>

      <!-- Social & Legal Column -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-4">
          <%= t.footer_social %>
        </h3>
        <ul class="space-y-2 text-sm mb-6">
          <% if (settings.github) { %>
          <li>
            <a href="<%= settings.github %>" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-2 transition-colors">
              <span>GitHub</span>
              <span class="text-xs text-slate-400">↗</span>
            </a>
          </li>
          <% } %>
          <% if (settings.telegram) { %>
          <li>
            <a href="<%= settings.telegram %>" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-2 transition-colors">
              <span>Telegram</span>
              <span class="text-xs text-slate-400">↗</span>
            </a>
          </li>
          <% } %>
          <% if (settings.linkedin) { %>
          <li>
            <a href="<%= settings.linkedin %>" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-2 transition-colors">
              <span>LinkedIn</span>
              <span class="text-xs text-slate-400">↗</span>
            </a>
          </li>
          <% } %>
          <% if (settings.email) { %>
          <li>
            <a href="mailto:<%= settings.email %>" class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-2 transition-colors">
              <span><%= settings.email %></span>
            </a>
          </li>
          <% } %>
        </ul>

        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-2">
          <%= t.footer_legal %>
        </h3>
        <ul class="space-y-1.5 text-xs">
          <li>
            <a href="/privacy-policy" class="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
              <%= t.privacy_title %>
            </a>
          </li>
          <li>
            <a href="/terms" class="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
              <%= t.terms_title %>
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" target="_blank" class="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
              Sitemap.xml
            </a>
          </li>
          <li>
            <a href="/robots.txt" target="_blank" class="text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
              Robots.txt
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-4">
      <div>
        © <%= new Date().getFullYear() %> <%= settings.site_name || 'DheyaDev' %> — <span class="font-medium"><%= currentLang === 'ar' ? (settings.author_name_ar || 'ضياء عباس') : (settings.author_name || 'Dheya Abbas') %></span>. <%= t.footer_rights %>
      </div>
      <div class="flex items-center gap-4">
        <span>Built with Clean Architecture</span>
        <span>•</span>
        <a href="/admin" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Admin CMS</a>
      </div>
    </div>
  </div>
</footer>
