<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <%- include('partials/breadcrumbs') %>

  <!-- Search Bar Header -->
  <div class="mb-10">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      <%= t.search_title %>
    </h1>
    
    <form action="/search" method="GET" class="relative max-w-2xl">
      <% if (currentLang === 'en') { %>
        <input type="hidden" name="lang" value="en">
      <% } %>
      <input 
        type="text" 
        name="q" 
        value="<%= query %>" 
        placeholder="<%= t.search_placeholder %>" 
        class="w-full px-5 py-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none shadow-sm"
        required
      >
      <button type="submit" class="absolute end-3 top-3 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-colors">
        <%= t.search_title %>
      </button>
    </form>
  </div>

  <% if (query) { %>
    <div class="mb-8 text-sm text-slate-500 font-mono">
      <%= t.search_query_prefix %> <span class="font-bold text-slate-900 dark:text-white">"<%= query %>"</span>: 
      <%= matchingPosts.length %> <%= t.search_found_articles %>, <%= matchingProjects.length %> <%= t.search_found_projects %>
    </div>
  <% } %>

  <!-- Results: Articles -->
  <% if (matchingPosts.length > 0) { %>
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <span>📝</span>
        <span><%= t.search_found_articles %></span>
      </h2>
      <div class="space-y-4">
        <% matchingPosts.forEach(post => { %>
          <article class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-blue-500 transition-colors">
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold"><%= post.category_name %></span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">
              <a href="/blog/<%= post.slug %><%= currentLang === 'en' ? '?lang=en' : '' %>" class="hover:underline">
                <%= currentLang === 'ar' ? (post.title_ar || post.title) : post.title %>
              </a>
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 line-clamp-2">
              <%= currentLang === 'ar' ? (post.excerpt_ar || post.excerpt) : post.excerpt %>
            </p>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Results: Projects -->
  <% if (matchingProjects.length > 0) { %>
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <span>🚀</span>
        <span><%= t.search_found_projects %></span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% matchingProjects.forEach(proj => { %>
          <article class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-blue-500 transition-colors">
            <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-bold"><%= proj.category %></span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">
              <a href="/projects/<%= proj.slug %><%= currentLang === 'en' ? '?lang=en' : '' %>" class="hover:underline">
                <%= currentLang === 'ar' ? (proj.title_ar || proj.title) : proj.title %>
              </a>
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 line-clamp-2">
              <%= currentLang === 'ar' ? (proj.short_description_ar || proj.short_description) : proj.short_description %>
            </p>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (query && matchingPosts.length === 0 && matchingProjects.length === 0) { %>
    <div class="p-12 text-center rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <p class="text-slate-500"><%= t.search_no_results %></p>
    </div>
  <% } %>

</div>
