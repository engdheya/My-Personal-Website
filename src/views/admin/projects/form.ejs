<div class="max-w-4xl mx-auto space-y-8">
  
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">
        <%= isEdit ? 'Edit Project' : 'Create New Project' %>
      </h1>
      <p class="text-xs text-slate-500 font-mono mt-0.5">Manage project portfolio showcase data</p>
    </div>
    <a href="/admin/projects" class="text-xs font-semibold text-slate-500 hover:text-slate-900 dark:hover:text-white">
      ← Back to Projects
    </a>
  </div>

  <form action="<%= isEdit ? '/admin/projects/' + project.id : '/admin/projects' %>" method="POST" class="space-y-8">
    
    <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Title (English) <span class="text-rose-500">*</span></label>
          <input type="text" id="title" name="title" required value="<%= project.title || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div>
          <label for="title_ar" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Title (Arabic)</label>
          <input type="text" id="title_ar" name="title_ar" dir="rtl" value="<%= project.title_ar || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="slug" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Slug URL <span class="text-rose-500">*</span></label>
          <input type="text" id="slug" name="slug" required value="<%= project.slug || '' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div>
          <label for="category" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Category</label>
          <input type="text" id="category" name="category" value="<%= project.category || 'Full Stack' %>" placeholder="e.g. Full Stack, Mobile App" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <label for="status" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Status</label>
          <select id="status" name="status" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <option value="Completed" <%= project.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            <option value="In Progress" <%= project.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
            <option value="Archived" <%= project.status === 'Archived' ? 'selected' : '' %>>Archived</option>
          </select>
        </div>

        <div>
          <label for="project_date" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Project Date</label>
          <input type="text" id="project_date" name="project_date" value="<%= project.project_date || 'August 2026' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div class="flex items-center pt-6">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="is_featured" value="1" <%= project.is_featured ? 'checked' : '' %> class="w-4 h-4 rounded text-blue-600">
            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Feature on Homepage</span>
          </label>
        </div>
      </div>

      <div>
        <label for="technologies" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Technologies (Comma separated)</label>
        <input type="text" id="technologies" name="technologies" value="<%= project.technologies || 'Laravel, Flutter, MySQL, REST API' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="github_url" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">GitHub URL</label>
          <input type="url" id="github_url" name="github_url" value="<%= project.github_url || '' %>" placeholder="https://github.com/..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div>
          <label for="live_url" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Live Demo URL</label>
          <input type="url" id="live_url" name="live_url" value="<%= project.live_url || '' %>" placeholder="https://..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>

      <div>
        <label for="main_image" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Main Image URL</label>
        <input type="text" id="main_image" name="main_image" value="<%= project.main_image || '/images/projects/smart-store-main.jpg' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <div>
        <label for="short_description" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Short Description</label>
        <textarea id="short_description" name="short_description" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= project.short_description || '' %></textarea>
      </div>

      <div>
        <label for="description" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Full Description & Architecture</label>
        <textarea id="description" name="description" rows="6" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= project.description || '' %></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="problem" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Problem / Challenge</label>
          <textarea id="problem" name="problem" rows="3" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= project.problem || '' %></textarea>
        </div>

        <div>
          <label for="solution" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Solution Delivered</label>
          <textarea id="solution" name="solution" rows="3" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"><%= project.solution || '' %></textarea>
        </div>
      </div>

    </div>

    <!-- Submit -->
    <div class="flex items-center justify-end gap-3">
      <a href="/admin/projects" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold hover:bg-slate-100 dark:hover:bg-slate-800">Cancel</a>
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow cursor-pointer">
        <%= isEdit ? 'Update Project' : 'Create Project' %>
      </button>
    </div>

  </form>

</div>
