<div class="space-y-6">
  
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Contact Messages</h1>
      <p class="text-xs text-slate-500 font-mono mt-0.5">Incoming inquiries and consultation requests</p>
    </div>
  </div>

  <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 uppercase tracking-wider font-mono">
        <tr>
          <th class="px-6 py-4">Sender</th>
          <th class="px-6 py-4">Subject</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Date</th>
          <th class="px-6 py-4 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% if (messages.length === 0) { %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-slate-500">No contact messages received yet.</td>
          </tr>
        <% } %>
        <% messages.forEach(msg => { %>
          <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 <%= msg.status === 'unread' ? 'bg-blue-50/30 dark:bg-blue-950/20' : '' %>">
            <td class="px-6 py-4">
              <div class="font-bold text-slate-900 dark:text-white"><%= msg.name %></div>
              <div class="text-slate-400 font-mono text-[11px]"><%= msg.email %></div>
            </td>
            <td class="px-6 py-4 max-w-sm">
              <div class="font-semibold text-slate-800 dark:text-slate-200 truncate"><%= msg.subject %></div>
              <div class="text-slate-500 truncate text-[11px] mt-0.5"><%= msg.message %></div>
            </td>
            <td class="px-6 py-4">
              <% if (msg.status === 'unread') { %>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">Unread</span>
              <% } else { %>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400"><%= msg.status %></span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-slate-500 font-mono">
              <%= new Date(msg.created_at).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 text-right space-x-2">
              <a href="/admin/messages/<%= msg.id %>" class="text-blue-600 hover:underline font-semibold">View</a>
              <span class="text-slate-300">|</span>
              <form action="/admin/messages/<%= msg.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this message?');">
                <button type="submit" class="text-rose-600 hover:text-rose-800 font-semibold cursor-pointer">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</div>
