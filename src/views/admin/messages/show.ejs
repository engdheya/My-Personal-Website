<div class="max-w-3xl mx-auto space-y-6">
  
  <div class="flex items-center justify-between">
    <a href="/admin/messages" class="text-xs font-semibold text-slate-500 hover:text-slate-900 dark:hover:text-white">← Back to Messages</a>
    <div class="flex items-center gap-2">
      <form action="/admin/messages/<%= msg.id %>/toggle" method="POST" class="inline">
        <button type="submit" class="px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800">
          Mark as <%= msg.status === 'unread' ? 'Read' : 'Unread' %>
        </button>
      </form>
      <form action="/admin/messages/<%= msg.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete message?');">
        <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold">Delete</button>
      </form>
    </div>
  </div>

  <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-4">
      <div class="flex items-center justify-between gap-4">
        <h1 class="text-xl font-bold text-slate-900 dark:text-white"><%= msg.subject %></h1>
        <span class="text-xs font-mono text-slate-400"><%= new Date(msg.created_at).toLocaleString() %></span>
      </div>
      <div class="mt-2 text-xs text-slate-500 font-mono">
        From: <strong class="text-slate-900 dark:text-white"><%= msg.name %></strong> &lt;<a href="mailto:<%= msg.email %>" class="text-blue-600 hover:underline"><%= msg.email %></a>&gt;
      </div>
    </div>

    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700 text-sm text-slate-800 dark:text-slate-200 leading-relaxed whitespace-pre-wrap">
      <%= msg.message %>
    </div>

    <div class="pt-4 flex items-center gap-3">
      <a href="mailto:<%= msg.email %>?subject=Re:%20<%= encodeURIComponent(msg.subject) %>" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow flex items-center gap-2">
        <span>✉️</span>
        <span>Reply via Email Client</span>
      </a>
    </div>
  </div>

</div>
