<div class="max-w-4xl mx-auto space-y-8">
  
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">
        <%= isEdit ? 'Edit Article' : 'Create New Article' %>
      </h1>
      <p class="text-xs text-slate-500 font-mono mt-0.5">Write engaging, SEO-optimized technical guides</p>
    </div>
    <a href="/admin/posts" class="text-xs font-semibold text-slate-500 hover:text-slate-900 dark:hover:text-white">
      ← Back to Posts
    </a>
  </div>

  <form action="<%= isEdit ? '/admin/posts/' + post.id : '/admin/posts' %>" method="POST" class="space-y-8">
    
    <!-- General Content Card -->
    <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Title (English) <span class="text-rose-500">*</span></label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            value="<%= post.title || '' %>"
            oninput="autoSlug(this.value); updateGooglePreview();"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
        </div>

        <div>
          <label for="title_ar" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Title (Arabic)</label>
          <input 
            type="text" 
            id="title_ar" 
            name="title_ar" 
            dir="rtl"
            value="<%= post.title_ar || '' %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="slug" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Slug URL <span class="text-rose-500">*</span></label>
          <div class="flex items-center">
            <span class="px-3 py-2.5 rounded-s-xl bg-slate-100 dark:bg-slate-800 border border-e-0 border-slate-200 dark:border-slate-700 text-xs text-slate-500 font-mono">/blog/</span>
            <input 
              type="text" 
              id="slug" 
              name="slug" 
              required 
              value="<%= post.slug || '' %>"
              oninput="updateGooglePreview();"
              class="w-full px-4 py-2.5 rounded-e-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
          </div>
        </div>

        <div>
          <label for="category_id" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Category <span class="text-rose-500">*</span></label>
          <select 
            id="category_id" 
            name="category_id" 
            required 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= post.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="status" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Status</label>
          <select 
            id="status" 
            name="status" 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <option value="published" <%= post.status === 'published' ? 'selected' : '' %>>Published (Live)</option>
            <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>Draft (Hidden)</option>
            <option value="archived" <%= post.status === 'archived' ? 'selected' : '' %>>Archived</option>
          </select>
        </div>

        <div>
          <label for="featured_image" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Featured Image URL</label>
          <input 
            type="text" 
            id="featured_image" 
            name="featured_image" 
            value="<%= post.featured_image || '/images/posts/laravel-mysql-driver.jpg' %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
        </div>
      </div>

      <div>
        <label for="excerpt" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Short Excerpt (English)</label>
        <textarea 
          id="excerpt" 
          name="excerpt" 
          rows="2"
          oninput="updateGooglePreview();"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
        ><%= post.excerpt || '' %></textarea>
      </div>

      <div>
        <label for="content" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Content (Markdown & Code) <span class="text-rose-500">*</span></label>
        <p class="text-[11px] text-slate-400 mb-2 font-mono">Supports H2 (##), H3 (###) for Table of Contents, and triple backticks (```php, ```bash) for syntax highlighted code blocks.</p>
        <textarea 
          id="content" 
          name="content" 
          rows="14" 
          required
          class="w-full p-4 rounded-xl bg-slate-950 text-slate-100 font-mono text-xs border border-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none leading-relaxed"
        ><%= post.content || '' %></textarea>
      </div>

    </div>

    <!-- SEO Settings & Google Preview (Requirement 32, 33, 93) -->
    <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
      
      <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-4">
        <span class="text-lg">🔍</span>
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white">SEO & Google Search Settings</h2>
          <p class="text-xs text-slate-400 font-mono">Fine-tune how this article appears on Google Search and social sharing cards</p>
        </div>
      </div>

      <!-- Live Google Search Preview (Requirement 93) -->
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3 font-mono">Google Search Result Preview</div>
        <div class="space-y-1">
          <div class="text-xs text-slate-600 dark:text-slate-400 font-mono flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-blue-600 text-[10px] text-white flex items-center justify-center font-bold">D</span>
            <span>https://dheyadev.com › blog › <span id="preview-slug">laravel-mysql-driver</span></span>
          </div>
          <div id="preview-title" class="text-base font-medium text-blue-700 dark:text-blue-400 hover:underline cursor-pointer">
            How to Fix Laravel MySQL Driver Error | DheyaDev
          </div>
          <div id="preview-desc" class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl">
            Complete guide to fixing the Laravel "could not find driver" MySQL PDO exception on Windows, XAMPP, and Linux servers.
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="seo_title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">SEO Title</label>
          <input 
            type="text" 
            id="seo_title" 
            name="seo_title" 
            value="<%= post.seo_title || '' %>"
            oninput="updateGooglePreview();"
            placeholder="Custom title tag (defaults to article title)"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
        </div>

        <div>
          <label for="focus_keyword" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Focus Keyword</label>
          <input 
            type="text" 
            id="focus_keyword" 
            name="focus_keyword" 
            value="<%= post.focus_keyword || '' %>"
            placeholder="e.g. laravel mysql driver error"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
        </div>
      </div>

      <div>
        <label for="meta_description" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Meta Description (150-160 characters)</label>
        <textarea 
          id="meta_description" 
          name="meta_description" 
          rows="2"
          oninput="updateGooglePreview();"
          placeholder="Brief description that entices searchers to click..."
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
        ><%= post.meta_description || '' %></textarea>
      </div>

      <div>
        <label for="canonical_url" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Canonical URL (Optional override)</label>
        <input 
          type="url" 
          id="canonical_url" 
          name="canonical_url" 
          value="<%= post.canonical_url || '' %>"
          placeholder="https://dheyadev.com/blog/..."
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
      </div>

    </div>

    <!-- Submit buttons -->
    <div class="flex items-center justify-end gap-3 pt-4">
      <a href="/admin/posts" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        Cancel
      </a>
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition-colors cursor-pointer">
        <%= isEdit ? 'Save Changes' : 'Publish Article' %>
      </button>
    </div>

  </form>

</div>

<script>
  function autoSlug(text) {
    const slugInput = document.getElementById('slug');
    if (!slugInput.dataset.manual) {
      slugInput.value = text.toLowerCase()
        .replace(/[^\w\s-]/g, '')
        .trim()
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }
  }

  function updateGooglePreview() {
    const title = document.getElementById('seo_title').value || document.getElementById('title').value || 'Article Title';
    const slug = document.getElementById('slug').value || 'article-slug';
    const desc = document.getElementById('meta_description').value || document.getElementById('excerpt').value || 'Short description of the article will appear here...';

    document.getElementById('preview-title').innerText = title + ' | DheyaDev';
    document.getElementById('preview-slug').innerText = slug;
    document.getElementById('preview-desc').innerText = desc;
  }

  document.getElementById('slug').addEventListener('change', function() {
    this.dataset.manual = 'true';
  });

  updateGooglePreview();
</script>
