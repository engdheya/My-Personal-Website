<div class="space-y-6">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Articles & Posts</h1>
      <p class="text-xs text-slate-500 font-mono mt-0.5">Manage, draft, schedule, and publish technical guides</p>
    </div>
    <a href="/admin/posts/new" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow transition-colors flex items-center gap-1.5 self-start sm:self-auto">
      <span>+</span>
      <span>New Article</span>
    </a>
  </div>

  <!-- Search & Filter Bar -->
  <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4 shadow-sm">
    <form action="/admin/posts" method="GET" class="flex items-center gap-2 flex-1 max-w-md">
      <input 
        type="text" 
        name="search" 
        value="<%= search || '' %>" 
        placeholder="Filter by title..." 
        class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
      >
      <button type="submit" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-semibold hover:bg-slate-200">
        Filter
      </button>
    </form>

    <div class="flex items-center gap-2 text-xs">
      <span class="text-slate-400">Status:</span>
      <a href="/admin/posts" class="px-2.5 py-1 rounded-lg <%= !selectedStatus ? 'bg-blue-600 text-white font-bold' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300' %>">All</a>
      <a href="/admin/posts?status=published" class="px-2.5 py-1 rounded-lg <%= selectedStatus === 'published' ? 'bg-blue-600 text-white font-bold' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300' %>">Published</a>
      <a href="/admin/posts?status=draft" class="px-2.5 py-1 rounded-lg <%= selectedStatus === 'draft' ? 'bg-blue-600 text-white font-bold' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300' %>">Draft</a>
    </div>
  </div>

  <!-- Posts Table -->
  <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 uppercase tracking-wider font-mono">
        <tr>
          <th class="px-6 py-4">Title & Slug</th>
          <th class="px-6 py-4">Category</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Published Date</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        <% if (posts.length === 0) { %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-slate-500">No articles found. Click "New Article" to write one.</td>
          </tr>
        <% } %>
        <% posts.forEach(post => { %>
          <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
            <td class="px-6 py-4">
              <div class="font-bold text-slate-900 dark:text-white text-sm"><%= post.title %></div>
              <div class="text-slate-400 font-mono text-[11px] mt-0.5">/blog/<%= post.slug %></div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2.5 py-1 rounded-md bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-semibold text-[11px]">
                <%= post.category_name %>
              </span>
            </td>
            <td class="px-6 py-4">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= post.status === 'published' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' %>">
                <%= post.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-slate-500 font-mono">
              <%= new Date(post.published_at).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 text-right space-x-2">
              <a href="/blog/<%= post.slug %>" target="_blank" class="text-slate-400 hover:text-blue-600 font-semibold" title="View Public Article">
                View ↗
              </a>
              <span class="text-slate-300">|</span>
              <a href="/admin/posts/<%= post.id %>/edit" class="text-blue-600 hover:text-blue-800 dark:hover:text-blue-400 font-semibold">
                Edit
              </a>
              <span class="text-slate-300">|</span>
              <form action="/admin/posts/<%= post.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this article?');">
                <button type="submit" class="text-rose-600 hover:text-rose-800 dark:hover:text-rose-400 font-semibold cursor-pointer">
                  Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</div>
