<!-- Filament Style Dashboard (Requirement 25, 94) -->
<div class="space-y-8">
  
  <!-- Welcome Banner -->
  <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-900/60 via-indigo-900/40 to-slate-900 border border-blue-800/40 text-white flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-sm">
    <div class="space-y-1">
      <h1 class="text-2xl font-bold tracking-tight">Welcome back, <%= user.name %>!</h1>
      <p class="text-xs sm:text-sm text-blue-200">Everything is running smoothly. Here is a summary of your website metrics.</p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/posts/new" class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition-colors flex items-center gap-1.5">
        <span>+</span>
        <span>New Article</span>
      </a>
      <a href="/admin/projects/new" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5">
        <span>+</span>
        <span>New Project</span>
      </a>
    </div>
  </div>

  <!-- Metric Stat Cards (Requirement 94) -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Total Posts</div>
      <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-mono"><%= stats.totalPosts %></div>
      <div class="text-[11px] text-blue-600 mt-1">Articles</div>
    </div>

    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Published</div>
      <div class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono"><%= stats.publishedPosts %></div>
      <div class="text-[11px] text-emerald-600 mt-1">Live to visitors</div>
    </div>

    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Drafts</div>
      <div class="text-3xl font-extrabold text-amber-500 font-mono"><%= stats.draftPosts %></div>
      <div class="text-[11px] text-amber-600 mt-1">Unpublished</div>
    </div>

    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Projects</div>
      <div class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 font-mono"><%= stats.totalProjects %></div>
      <div class="text-[11px] text-indigo-500 mt-1">Portfolio items</div>
    </div>

    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Messages</div>
      <div class="text-3xl font-extrabold text-rose-500 font-mono"><%= stats.totalMessages %></div>
      <div class="text-[11px] text-rose-500 mt-1"><%= stats.unreadMessages %> unread</div>
    </div>

    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Categories</div>
      <div class="text-3xl font-extrabold text-sky-600 dark:text-sky-400 font-mono"><%= stats.totalCategories %></div>
      <div class="text-[11px] text-sky-500 mt-1">Topics</div>
    </div>

  </div>

  <!-- Recent Content Tables -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- Recent Posts -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">Recent Articles</h2>
        <a href="/admin/posts" class="text-xs text-blue-600 font-semibold hover:underline">View All →</a>
      </div>

      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        <% recentPosts.forEach(post => { %>
          <div class="py-3 flex items-center justify-between gap-4">
            <div class="min-w-0">
              <h3 class="text-xs font-bold text-slate-900 dark:text-white truncate">
                <a href="/admin/posts/<%= post.id %>/edit" class="hover:text-blue-600"><%= post.title %></a>
              </h3>
              <div class="flex items-center gap-2 text-[10px] text-slate-500 font-mono mt-0.5">
                <span><%= post.category_name %></span>
                <span>•</span>
                <span><%= new Date(post.published_at).toLocaleDateString() %></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= post.status === 'published' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300' : 'bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300' %>">
                <%= post.status %>
              </span>
              <a href="/admin/posts/<%= post.id %>/edit" class="text-xs text-slate-400 hover:text-blue-600">✏️</a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Recent Messages -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">Recent Contact Inquiries</h2>
        <a href="/admin/messages" class="text-xs text-blue-600 font-semibold hover:underline">View All →</a>
      </div>

      <% if (recentMessages.length === 0) { %>
        <p class="text-xs text-slate-500 py-4">No contact messages received yet.</p>
      <% } else { %>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          <% recentMessages.forEach(msg => { %>
            <div class="py-3 flex items-center justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="text-xs font-bold text-slate-900 dark:text-white truncate"><%= msg.name %></h3>
                  <% if (msg.status === 'unread') { %>
                    <span class="px-1.5 py-0.5 rounded bg-rose-500 text-white text-[9px] font-bold">NEW</span>
                  <% } %>
                </div>
                <div class="text-[11px] text-slate-500 truncate mt-0.5"><%= msg.subject %></div>
              </div>
              <a href="/admin/messages/<%= msg.id %>" class="text-xs text-blue-600 hover:underline flex-shrink-0 font-semibold">
                Read →
              </a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

</div>
